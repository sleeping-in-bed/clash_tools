#: ../../source/wg_docker/index.rst:199
msgid "Troubleshooting"
msgstr "故障排查"

#: ../../source/wg_docker/index.rst:201
msgid "``wg`` missing: Install WireGuard tools (e.g., ``apt install wireguard``) to enable key generation"
msgstr "缺少 ``wg``：请安装 WireGuard 工具（如 ``apt install wireguard``）以启用密钥生成"

#: ../../source/wg_docker/index.rst:202
msgid "Docker issues: Verify Docker service and compose functionality"
msgstr "Docker 问题：确认 Docker 服务与 compose 正常"

#: ../../source/wg_docker/index.rst:203
msgid "Port collision: Ensure ``listen_port`` and any forwarded ``server_port`` values are not already used on the host"
msgstr "端口冲突：确保 ``listen_port`` 与所有转发的 ``server_port`` 未被宿主机占用"

#: ../../source/wg_docker/index.rst:204
msgid "Firewall: Confirm that host firewall permits UDP ``listen_port`` and any forwarded TCP/UDP ports"
msgstr "防火墙：确认宿主机放行 UDP ``listen_port`` 及所有转发的 TCP/UDP 端口"

#: ../../source/wg_docker/index.rst:205
msgid "Logs: Use ``docker compose -f $(python -m clash_tools.wg_docker.cli server config --path | sed 's/server_config.yml/server_compose.yml/') logs | cat`` to inspect runtime logs"
msgstr "日志：使用 ``docker compose -f $(python -m clash_tools.wg_docker.cli server config --path | sed 's/server_config.yml/server_compose.yml/') logs | cat`` 查看运行日志"

#: ../../source/wg_docker/index.rst:208
msgid "Security Notes"
msgstr "安全注意事项"

#: ../../source/wg_docker/index.rst:210
msgid "Keep ``wg_keys.json`` secured; it contains private keys"
msgstr "妥善保护 ``wg_keys.json``；其中包含私钥"

#: ../../source/wg_docker/index.rst:211
msgid "Review ``excludedips`` and ``allowedips`` to avoid unintentionally leaking traffic"
msgstr "检查 ``excludedips`` 与 ``allowedips`` 以避免意外泄露流量"

#: ../../source/wg_docker/index.rst:212
msgid "Validate ``server_ip`` and exposed ports before deploying to the public Internet"
msgstr "在公开部署前校验 ``server_ip`` 与暴露的端口"
